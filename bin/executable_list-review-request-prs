#!/bin/sh
# 自分 (所属チーム含む) にレビュー依頼が来ている open な PR を更新が新しい順に一覧する。
# 追加の引数は gh search prs にそのまま渡す (例: `list-review-request-prs --owner foo`, `--web`)。
set -eu

if ! command -v gh >/dev/null 2>&1; then
  echo "list-review-request-prs: gh is not installed" >&2
  exit 1
fi

exec gh search prs --review-requested=@me --state=open --sort=updated "$@"
